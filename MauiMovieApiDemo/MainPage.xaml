<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiMovieApiDemo"
             x:Class="MauiMovieApiDemo.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <HorizontalStackLayout VerticalOptions="Center">
                <Label Text="IMDb ID:" FontSize="20" HeightRequest="30" />
                <Entry 
                    x:Name="imdbIdTextBox" 
                    WidthRequest="100"
                    Text="tt0076759" />
            </HorizontalStackLayout>
                
            <Button 
                x:Name="fetchButton" 
                Text="Fetch Movie" 
                Clicked="fetchButton_Clicked" />

            <CollectionView 
                x:Name="movieCollectionView"
                HeightRequest="200"
                WidthRequest="300"
                ItemsSource="{Binding MovieList}"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Movie">
                        <HorizontalStackLayout Spacing="8" Padding="8">
                            <Label 
                            Text="{Binding Title}" 
                            FontAttributes="Bold"/>
                            <Label Text="{Binding Rated}" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout BindingContext="{x:Reference movieCollectionView}">
                <Label Text="{Binding SelectedItem.Year, Mode=TwoWay, StringFormat='Year: {0}'}" />
                <Label Text="{Binding SelectedItem.Genre, Mode=TwoWay, StringFormat='Genre: {0}'}" />
                <Label Text="{Binding SelectedItem.Plot, Mode=TwoWay, StringFormat='Plot: {0}'}" />
                <Label Text="{Binding SelectedItem.ImdbRating, Mode=TwoWay, StringFormat='IMDb rating: {0}'}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
